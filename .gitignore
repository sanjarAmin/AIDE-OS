# Build output
build/
.gradle
.kotlin
/captures
.externalNativeBuild
.cxx

# Local configuration
local.properties
*.iml
.DS_Store

# IDE state that is per-developer, not per-project
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
/.idea/deviceManager.xml
/.idea/deploymentTargetSelector.xml

# Spike inputs: ~100 MB of third-party jars, and the dex archive built from
# them. Regenerated by tools/kotlinc/build-kotlinc-dex.py -- see
# tools/kotlinc/FINDINGS.md. The aapt2 .so files under toolchain/ are NOT
# ignored: they take an AOSP checkout and a full build to reproduce.
/spike/kotlinc/src/androidTest/assets/*.jar
/spike/kotlinc/src/androidTest/assets/*.zip
/spike/jvmtools/src/androidTest/assets/*.jar
/engine/fast/src/androidTest/assets/android.jar
# Was committed by mistake and carried 27 MB of history until it was excised
# before the first push. Staged by hand like every other platform jar here.
/spike/javals/src/androidTest/assets/android.jar
# The Kotlin compiler dex archive (54 MB) and its stdlib, staged for the
# instrumented tests. Built by tools/kotlinc/build-kotlinc-dex.py; the stdlib
# comes from tools/kotlinc/fetch-jars.sh.
/engine/fast/src/androidTest/assets/kotlinc.jar
/engine/fast/src/androidTest/assets/kotlin-stdlib.jar
/lsp/java/src/androidTest/assets/android.jar
/app/src/androidTest/assets/android.jar

# Generated by :spike:rootfs -- the JVM launcher is compiled from
# src/main/jni/launch_jvm.c into the directory AGP packages from.
spike/rootfs/src/main/jniLibs/

# Built from toolchain/native/src/main/jni/launch_jvm.c into the directory AGP
# packages from; libaapt2.so and libjspawnhelper.so beside it are prebuilts and
# are tracked.
toolchain/native/src/main/jniLibs/*/libjvmlauncher.so
