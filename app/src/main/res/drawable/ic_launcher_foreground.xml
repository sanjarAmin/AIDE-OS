<?xml version="1.0" encoding="utf-8"?>
<!--
  The prompt, ">_", in strokes rather than text: a launcher draws this at a
  dozen sizes and through a dozen masks, and a vector path is the same glyph at
  all of them, where a font is whatever the device has.

  Inside the adaptive-icon safe zone (a 66 dp circle at the centre of the
  108 dp canvas) with room to spare, so no mask a launcher applies, round or
  squircle, clips it. The furthest point is about 26 dp from the centre.
  (No double hyphens in here: XML forbids them inside a comment, and the
  resource compiler fails on the file rather than skipping the comment.)

  Also the monochrome layer (mipmap-anydpi), which Android 13's themed icons
  tint: it is drawn on transparency, so only the glyph takes the tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M35,41 L49,53 L35,65"
        android:strokeWidth="6.5"
        android:strokeColor="#FF0B0E14"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M56,66 L74,66"
        android:strokeWidth="6.5"
        android:strokeColor="#FF0B0E14"
        android:strokeLineCap="round" />
</vector>
