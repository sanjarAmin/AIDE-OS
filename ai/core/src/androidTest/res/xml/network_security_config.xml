<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext to localhost only, for the test server.

    Android has blocked cleartext by default since API 28, and MockWebServer
    serves plain HTTP, so without this every request to the fake fails with
    `UnknownServiceException: CLEARTEXT communication to localhost not
    permitted`. It reads like an SDK fault and is not one.

    Scoped to loopback rather than a blanket `usesCleartextTraffic`: this file
    lives in androidTest and never ships, but a test fixture that quietly
    permits plaintext everywhere is the kind of thing that gets copied into a
    real manifest later.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
