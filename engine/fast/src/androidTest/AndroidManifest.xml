<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Test-only, and never merged into the app.

        From Android 11 an app cannot see packages it did not install. The
        install tests put the built APK on the device through `pm install`,
        which makes shell the installer and not this process, so PackageManager
        reports the package as not found without this. The app itself needs no
        equivalent: installing through PackageInstaller grants the installer
        visibility of what it installed.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
        The engine runs kotlinc, ECJ and D8 in-process, and a Compose project's
        dependency graph is around seventy artifacts. That does not fit the
        default 192 MB heap: the test process died with `Failed to allocate a
        152 byte allocation` part way through dexing.

        `:app` has always set this, so the shipped IDE was never affected.
        Only this harness was, by being quietly stricter than the environment
        the engine actually runs in. FINDINGS section 12.
    -->
    <application android:largeHeap="true" />

</manifest>
